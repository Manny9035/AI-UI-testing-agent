{
  "manifest_version": 3,
  "name": "NextOps",
  "version": "0.1.0",
  "description": "Check the website you have open. Functional, API, and security results you can hand over.",
  "permissions": ["sidePanel", "activeTab", "scripting", "tabs", "cookies"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:9477/*"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open NextOps",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
