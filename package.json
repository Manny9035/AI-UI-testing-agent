{
  "name": "nextops",
  "displayName": "NextOps",
  "description": "NextOps reads the code, chooses the test, and reports what passed. Composer Fast keeps the analysis cheap.",
  "version": "0.1.0",
  "publisher": "nextops",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Testing",
    "AI"
  ],
  "keywords": [
    "testing",
    "functional testing",
    "cursor",
    "quality engineering",
    "agent"
  ],
  "activationEvents": [
    "onView:nextops.agent"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nextops",
          "title": "NextOps",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "nextops": [
        {
          "type": "webview",
          "id": "nextops.agent",
          "name": "Agent",
          "retainContextWhenHidden": true,
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "nextops.focus",
        "title": "NextOps: Open Agent",
        "icon": "$(beaker)"
      },
      {
        "command": "nextops.newSession",
        "title": "NextOps: New Session",
        "icon": "$(add)"
      },
      {
        "command": "nextops.configureKey",
        "title": "NextOps: Open API Key File"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nextops.newSession",
          "when": "view == nextops.agent",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit && tsc -p browser/tsconfig.json",
    "test": "node esbuild.mjs --test && node dist/selftest.js",
    "browser": "node browser/dist/bridge.js"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.37",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.0"
  }
}
